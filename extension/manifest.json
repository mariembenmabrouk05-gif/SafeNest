{
  "manifest_version": 3,
  "name": "Projet Protect - Moniteur",
  "version": "1.0",
  "description": "Extension de contrôle parental pour Projet Protect",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Projet Protect"
  }
}
