# ─────────────────────────────────────────────────────────────
#  Projet Protect — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Claude / Anthropic ────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── PHP App ───────────────────────────────────────────────────
# URL where your projet_protect PHP app is served
PROTECT_BASE_URL=http://localhost/projet_protect

# Optional: must match API_KEY defined in api/add_event.php (leave blank if unused)
PROTECT_API_KEY=

# ── Monitoring ────────────────────────────────────────────────
# The DB id of the child user whose screen is being monitored
PROTECT_CHILD_ID=1

# How often (in seconds) to capture and analyse the screen
PROTECT_INTERVAL=10
